    {
      "block_id": "20260726_ee793a2d-3b21-491e-acf2-0bffa5f48f31_2_block_006",
      "coordinates": {
        "x1": 283.0,
        "y1": 1205.0,
        "x2": 2195.0,
        "y2": 1536.0
      },
      "layout_tag": "paragraph",
      "confidence": 0.9505113959312439,
      "reading_order": 7,
      "text": "The total number of FTA (Foreign Tourist Arrivals) as well as DTV (Domestic Tourist Visits) has\nincreased at the CAGR of 13.9% for the past 10 years. The number of tourists has increased from 466.89\nmillion in 2006 to 1,440.00 million in 2015. The CAGR of FTA is 7.6%, which is higher than the CAGR\nof DTV 13.9%. The number of FTA in 2015 (8.03 million) was only 0.56% of the total tourist visits in\nIndia."
    },
    {
      "block_id": "20260726_ee793a2d-3b21-491e-acf2-0bffa5f48f31_2_block_007",
      "coordinates": {
        "x1": 283.0,
        "y1": 1579.0,
        "x2": 2195.0,
        "y2": 1773.0
      },
      "layout_tag": "paragraph",
      "confidence": 0.9406575560569763,
      "reading_order": 8,
      "text": "While the growth rates of DTV have been stable, the growth rates of FTA have fluctuated being affected\nby the world economic trends; i.e., it recorded negative growth in 2002 and 2009 during the global\neconomic crisis."
    },
