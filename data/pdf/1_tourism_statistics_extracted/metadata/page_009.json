      "confidence": 0.851686418056488,
      "reading_order": 11,
      "text": "Table 3.3.2 Cultural Events in Varanasi (2017)"
    },
    {
      "block_id": "20260726_ee793a2d-3b21-491e-acf2-0bffa5f48f31_9_block_011",
      "coordinates": {
        "x1": 329.0,
