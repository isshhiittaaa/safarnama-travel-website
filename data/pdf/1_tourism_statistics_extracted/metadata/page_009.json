    {
      "block_id": "20260726_ee793a2d-3b21-491e-acf2-0bffa5f48f31_9_block_013",
      "coordinates": {
        "x1": 283.0,
        "y1": 2713.0,
        "x2": 2203.0,
        "y2": 3047.0
      },
      "layout_tag": "paragraph",
      "confidence": 0.9585786461830139,
      "reading_order": 14,
      "text": "The protection and promotion of Varanasi’s music has been supported for centuries, and the number of\nactive music companies in music sector has significantly increased to 3001. Such activities have led to\nan award of UNESCO’s ‘Cities of Music’ category under the Creative Cities Network in December 2015.\nTo celebrate Varanasi’s ‘City of Music’ heritage, a carnival of music, ‘Sur Ganga’ will be held in\nVaranasi from April 18 to May 30 in 2017. The objectives of the event are to promote Indian music"
    },
