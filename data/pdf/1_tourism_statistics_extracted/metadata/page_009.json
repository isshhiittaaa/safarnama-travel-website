      "layout_tag": "table",
      "confidence": 0.9632494449615479,
      "reading_order": 12,
      "text": "<table>\n<thead>\n<tr>\n<th>Cultural Event</th>\n<th>Date</th>\n<th>Cultural Event</th>\n<th>Date</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Ganga Mohotsav</td>\n<td>31 Oct - 03 Nov</td>\n<td>Ramleela Ramnagar</td>\n<td>5 Sep – 5 Oct</td>\n</tr>\n<tr>\n<td>‘Sur Ganga’ Music Festival</td>\n<td>18 Apr - 30 May</td>\n<td>Sankat Mochan Music Festival</td>\n<td>15 – 20 Apr</td>\n</tr>\n<tr>\n<td>Dhrupad Mela</td>\n<td>21 – 24 Feb</td>\n<td>Naag Nathaiya</td>\n<td>23 Oct</td>\n</tr>\n<tr>\n<td>Buddha Poornima</td>\n<td>10 May</td>\n<td>Ganga Dushehra</td>\n<td>3 June</td>\n</tr>\n</tbody>\n</table>"
    },
    {
